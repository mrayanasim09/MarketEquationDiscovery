# Legacy v1 results directory
results/

# -----------------------------------------------------------------------
# Experiment outputs: large binary/log artefacts are excluded; metadata,
# configs, tuning manifests, manuscript tables/figures, and reports ARE
# tracked so the repository is fully self-contained and reproducible.
# -----------------------------------------------------------------------

# Large binary forecast/metric outputs (reproduce from scripts)
experiments/results/v2_1/forecasts.parquet
experiments/results/v2_1/metrics.parquet
experiments/results/v2_1/dm_tests.parquet

# Transient execution artefacts
experiments/results/v2_1/staging/
experiments/results/v2_1/checkpoints/
experiments/results/v2_1/execution_log.txt
experiments/results/v2_1/failed_transactions.jsonl

# v2 pre-release run artefacts (archived; binary checkpoints excluded)
experiments/results/v2/checkpoints/
experiments/results/v2/metadata/validation.json

# Everything else in experiments/ is tracked:
#   configs/, tuning/, metadata/output_hashes.json,
#   metadata/pre_execution_audit.json, metadata/pre_execution_environment.json,
#   manuscript/ (tables + figures), analysis/ CSVs, run_manifest.json,
#   environment_manifest.json, FINAL_EXPERIMENT_REPORT.md
